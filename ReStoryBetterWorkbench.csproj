<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ReStoryBetterWorkbench</AssemblyName>
    <RootNamespace>ReStoryBetterWorkbench</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>
    <!-- Unity ships its own facades; don't drag in NuGet reference assemblies. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- NU1701: MelonLoader ships a net35 assembly; Unity's Mono runtime loads it fine. -->
    <NoWarn>$(NoWarn);CS0436;NU1701</NoWarn>

    <GameDir>A:\Program Files (x86)\Steam\steamapps\common\Restory</GameDir>
    <Managed>$(GameDir)\Restory_Data\Managed</Managed>
  </PropertyGroup>

  <!-- Mod loader flavor: default builds the BepInEx plugin, -p:Loader=Melon the MelonLoader mod. -->
  <PropertyGroup Condition="'$(Loader)' != 'Melon'">
    <LoaderName>BepInEx</LoaderName>
    <DeployDir>$(GameDir)\BepInEx\plugins\$(AssemblyName)\</DeployDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Loader)' == 'Melon'">
    <LoaderName>MelonLoader</LoaderName>
    <DeployDir>$(GameDir)\Mods\</DeployDir>
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
    <!-- Own output and obj folders, so building one flavor doesn't clean the other one's DLL away. -->
    <OutputPath>bin\$(Configuration)\Melon\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\Melon\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(Loader)' != 'Melon'">
    <Reference Include="$(PkgBepInEx_BaseLib)\lib\net35\BepInEx.dll" Private="false" />
    <Reference Include="$(PkgHarmonyX)\lib\net35\0Harmony.dll" Private="false" />
  </ItemGroup>

  <!-- Restored for both flavors, so switching flavors can't leave the restore state behind. NuGet only
       downloads these; they are referenced by path like every other assembly here, so their .NET Standard
       facades never end up fighting Unity's own mscorlib. 0.6.6 is the oldest supported loader and has no
       transitive deps; the API used here is unchanged in 0.7.x, so the same DLL loads under both. BepInEx
       comes from its own feed (see NuGet.config) so the plugin builds without BepInEx installed; 5.4.21 is
       API-identical to the 5.4.23.x the README asks for. -->
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.6.6"
                      GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.10.2"
                      GeneratePathProperty="true" ExcludeAssets="all" />
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.21"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(Loader)' == 'Melon'">
    <Reference Include="$(PkgLavaGang_MelonLoader)\lib\net35\MelonLoader.dll" Private="false" />
    <Reference Include="$(PkgHarmonyX)\lib\net35\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(Managed)\mscorlib.dll" Private="false" />
    <Reference Include="$(Managed)\netstandard.dll" Private="false" />
    <Reference Include="$(Managed)\System.dll" Private="false" />
    <Reference Include="$(Managed)\System.Core.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.TextMeshPro.dll" Private="false" />
    <!-- FMOD EventReference, for playing the game's own UI click sound. -->
    <Reference Include="$(Managed)\FMODUnity.dll" Private="false" />
    <!-- Rewired KeyboardKeyCode, for looking up the game's own key glyph sprites. -->
    <Reference Include="$(Managed)\Rewired_Core.dll" Private="false" />
    <!-- ElementInfo -> RestoryEntityInfoBase -> Odin's SerializedScriptableObject. -->
    <Reference Include="$(Managed)\Sirenix.Serialization.dll" Private="false" />
    <Reference Include="$(Managed)\Restory.Assembly.dll" Private="false" />
    <Reference Include="$(Managed)\Mandragora.Helpers.Assembly.dll" Private="false" />
  </ItemGroup>

  <!-- Automatic deploy the build in the correct path. -->
  <Target Name="Deploy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Condition="'$(Configuration)' == 'Debug'"
             Text="Deployed $(AssemblyName).dll -> $(DeployDir) [$(LoaderName), DEBUG - dev logs ON]" />
    <Message Importance="high" Condition="'$(Configuration)' != 'Debug'"
             Text="Deployed $(AssemblyName).dll -> $(DeployDir) [$(LoaderName), RELEASE - dev logs stripped]" />
  </Target>

</Project>
